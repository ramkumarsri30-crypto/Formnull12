# FormNull — environment variables template
# Copy to .env (Prisma) and .env.local (Supabase) and fill in real values.
# NEVER commit real .env or .env.local files to version control.

# Prisma datasource (local SQLite)
# e.g. file:/absolute/path/to/db/custom.db
DATABASE_URL=

# Supabase project (public — safe for client code)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key (public — used by the browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret/service-role key — SERVER ONLY, bypasses RLS.
# Never expose to the client or commit to version control.
SUPABASE_SERVICE_ROLE_KEY=

# ── Field Expansion (migration 008) — payment processing ─────────────
# Stripe keys are OPTIONAL: without them payment fields render an honest
# "payment not configured" state and never fake a charge. Get them at
# dashboard.stripe.com → Developers → API keys / Webhooks.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook endpoint to register in Stripe: https://<your-domain>/api/payments/webhook
# Event to listen for: checkout.session.completed
